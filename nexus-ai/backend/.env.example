# ─── NEXUS•AI Configuration ───
# Rename this file to .env and fill in your keys

# ─── Anthropic (Claude) ───
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: model for analysis and chat (default claude-opus-5-5).
# A Sonnet model such as claude-sonnet-5-5 costs less per call.
# ANTHROPIC_MODEL=claude-opus-5-5

# ─── Reddit API ───
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=NexusAI/1.0

# ─── Twitter/X API ───
# Apply at: https://developer.x.com/en/portal
# The recent-search endpoint used here needs a paid tier (Basic or higher);
# the free tier returns 403.
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ─── 4chan ───
# No API key needed — public JSON API

# ─── Server Config ───
PORT=8000
# 127.0.0.1 keeps the server private to this computer. The API has no login
# and the Claude endpoints spend your credits: only change this deliberately.
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
